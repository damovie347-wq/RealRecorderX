<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Default state: a small, unobtrusive draggable dot. Tap to expand;
         drag from anywhere on it to reposition. No FLAG_SECURE anymore (see
         RecordingOverlayController kdoc) means this dot really can end up in
         a recorded frame, so it is deliberately tiny and mostly transparent:
         a soft ~18% scrim just large enough to grab, around a small dot,
         rather than the old solid, dark 40dp circle. -->
    <FrameLayout
        android:id="@+id/collapsedDot"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_overlay_dot"
        android:elevation="6dp"
        android:visibility="visible">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:background="@drawable/dot_recording" />
    </FrameLayout>

    <!-- Expanded state: full control row, shown only while the user is
         actively interacting with it. -->
    <LinearLayout
        android:id="@+id/expandedRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_overlay_pill"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="6dp"
        android:visibility="gone">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_recording" />

        <TextView
            android:id="@+id/txtElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="00:00" />

        <ImageButton
            android:id="@+id/btnPauseResume"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_pause"
            android:contentDescription="@string/pause_recording"
            android:padding="6dp" />

        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_stop"
            android:contentDescription="@string/stop_recording"
            android:padding="6dp" />

        <ImageButton
            android:id="@+id/btnHide"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_hide"
            android:contentDescription="@string/hide_controls"
            android:padding="6dp"
            android:alpha="0.85" />

        <ImageButton
            android:id="@+id/btnCollapse"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_collapse"
            android:contentDescription="@string/minimize_controls"
            android:padding="6dp"
            android:alpha="0.7" />

    </LinearLayout>
</FrameLayout>
