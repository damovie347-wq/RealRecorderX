<?xml version="1.0" encoding="utf-8"?>
<!-- Barely-there scrim behind the collapsed dot: just enough to make the
     draggable handle findable against any background, deliberately far
     lighter than the old ~90%-opaque circle now that this can genuinely end
     up in a recorded frame (no more FLAG_SECURE; see
     RecordingOverlayController kdoc). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#30000000" />
</shape>
