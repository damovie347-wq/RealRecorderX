<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar / persistent-notification small icon, and the Quick Settings
     tile's idle-state icon (see RecordingTileService and the manifest's
     service icon attribute for RecordingTileService): every place this
     app's "record" mark shows up outside the app itself. Redrawn as the same
     ring + solid dot mark as ic_launcher_foreground (just monochrome, since
     the platform force-recolors every opaque pixel here from this shape's
     alpha channel regardless of the fillColor/strokeColor values below) so
     the shade/quick-panel glyph actually matches the app's own icon instead
     of being a plain, unrelated filled circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:pathData="M3.4,12 A8.6,8.6 0 1,1 20.6,12 A8.6,8.6 0 1,1 3.4,12 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.1"
        android:fillColor="#00000000" />
    <path
        android:pathData="M8.4,12 A3.6,3.6 0 1,1 15.6,12 A3.6,3.6 0 1,1 8.4,12 Z"
        android:fillColor="#FF000000" />
</vector>
