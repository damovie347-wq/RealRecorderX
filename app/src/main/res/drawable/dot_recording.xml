<?xml version="1.0" encoding="utf-8"?>
<!-- The actual "recording" indicator: small, fully-opaque so it reads
     clearly at a glance, with a thin light stroke so it stays legible
     against both dark and light content behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size
        android:width="10dp"
        android:height="10dp" />
    <solid android:color="@color/danger_red" />
    <stroke
        android:width="1.2dp"
        android:color="#CCFFFFFF" />
</shape>
